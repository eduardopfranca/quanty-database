# ===========================================
# Frontend (Next.js) — local dev
# ===========================================
# Base URL of the worker the frontend proxies to.
# Local dev: http://localhost:8000
# On Vercel (prod): set in the Vercel dashboard to the ngrok static domain — NOT here.
WORKER_URL=http://localhost:8000
#
# Shared secret for authenticated worker endpoints (run-update, download).
# Must equal WORKER_SECRET in the worker's root .env.
# Not needed yet — uncomment when the frontend gains update/download actions.
# WORKER_SECRET=
